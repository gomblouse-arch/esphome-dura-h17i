# Copy to secrets.yaml and fill in:
#   copy secrets.yaml.example secrets.yaml

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Generate: openssl rand -base64 32
api_encryption_key: "GENERATE_WITH_esphome_secrets_or_openssl"

ota_password: "YOUR_OTA_PASSWORD"

# Bluetooth MAC of your Duratech Dura-H17i (DURACLOUD device info or nRF Connect while advertising)
heatpump_mac: "AA:BB:CC:DD:EE:FF"
